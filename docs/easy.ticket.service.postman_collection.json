{
  "info": {
    "name": "easy.ticket.service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "ticketId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create Ticket",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/tickets",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"client-123\",\n  \"description\": \"Problema ao acessar o sistema\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.id) pm.collectionVariables.set('ticketId', res.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Ticket (with custom name)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/tickets",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"client-123\",\n  \"name\": \"EAS-00001\",\n  \"description\": \"Problema ao acessar o sistema\"\n}"
        }
      }
    },
    {
      "name": "Get Ticket",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/tickets/{{ticketId}}"
      }
    },
    {
      "name": "Complete Ticket",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/tickets/{{ticketId}}/complete"
      }
    }
  ]
}
